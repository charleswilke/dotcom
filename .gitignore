# .claude/* rather than .claude/ so a single file can be re-included below —
# git can't un-ignore anything whose parent directory is excluded outright.
.claude/*
!.claude/static-server.js
!.claude/launch.json
.DS_Store
.vercel
.env*.local
node_modules/

# Minified stylesheets written by tools/css-fidelity-check.sh for the fidelity
# harness. Throwaway: the real minification happens in Vercel's build container.
_fid-*.css

