# ===== Custom Error Pages =====
ErrorDocument 404 /404.html

# ===== URL Rewrites =====

# Serve mixtape.html for /mixtape URL (for OG meta tags / rich snippets)
# The page then redirects to /#mixtape for the actual lightbox
RewriteEngine On
RewriteRule ^mixtape/?$ /mixtape.html [L]

# Serve bsides.html for /bsides URL (for OG meta tags / rich snippets)
# The page then redirects to /#bsides for the actual lightbox
RewriteRule ^bsides/?$ /bsides.html [L]

# Serve side-two.html for /side-two URL (for OG meta tags / rich snippets)
# The page then redirects to /#bsides for the actual lightbox
RewriteRule ^side-two/?$ /side-two.html [L]

# Serve mixtape-side-two.html for /mixtape-side-two URL (for OG meta tags / rich snippets)
# The page then redirects to /#mixtape-side-two for the actual lightbox
RewriteRule ^mixtape-side-two/?$ /mixtape-side-two.html [L]

# Serve gwor.html for /gwor URL (for OG meta tags / rich snippets)
# The page then redirects to /#gwor for the actual lightbox
RewriteRule ^gwor/?$ /gwor.html [L]

# Serve grief-without-ritual.html for /grief-without-ritual URL (for OG meta tags / rich snippets)
# The page then redirects to /#gwor for the actual lightbox
RewriteRule ^grief-without-ritual/?$ /grief-without-ritual.html [L]

# Map /tootsjam to games/TootsJam (game) — redirect bare /tootsjam to /tootsjam/ so relative URLs resolve
RewriteRule ^tootsjam$ /tootsjam/ [R=301,L]
RewriteRule ^tootsjam/?$ games/TootsJam/tootsjam.html [L]
RewriteRule ^tootsjam/(.*)$ games/TootsJam/$1 [L]

# ===== Gzip Compression =====
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ===== Browser Caching =====
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ===== Security Headers =====
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header append Vary Accept-Encoding
    
    # Immutable cache hints for hashed/static assets
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|mp3|mp4|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Keep HTML and JSON dynamic responses fresh
    <FilesMatch "\.(html|php|json)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

