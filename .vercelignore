# Keep private working material and dev tooling out of the public deploy.
# Syntax follows .gitignore rules; !patterns re-include.

# Talk decks & WIP material — only viewer/ is served (via /s2i-present rewrite)
OMAxAI/*
!OMAxAI/viewer

# Dependencies & dev tooling. Minification now runs on Vercel, so tools/ is excluded by its
# *contents* rather than outright: a path under a flatly-excluded directory
# cannot be re-included, the same trap the OMAxAI/* and bt-assets/* rules below
# are shaped around. Everything in tools/ still stays out except the two files
# the build actually executes.
node_modules
**/node_modules
tools/*
!tools/minify-css.js
!tools/minify-js.js
# transcripts/*.md sources stay private via the *.md rule below; the
# pre-rendered .html fragments in transcripts/ ARE served (article reader
# fetches them), and an unanchored "transcripts/" here would also swallow
# images/transcripts/ (gitignore patterns match at any depth).
transcripts/**/*.zip
transcripts/**/*-assets
.lighthouse/
*.sh
*.code-workspace
tsconfig.json

# Docs, prototypes, legacy config
*.md
.htaccess
og-image.html
border-shape-lab.html
before-times-box-prototype.html

# Game source (ChessBlaster serves from dist/ only)
games/ChessBlaster/src
games/ChessBlaster/build
games/ChessBlaster/public
games/ChessBlaster/vite.config.ts

# Source art for the Sound Stage pen overlay. The page ships the pen-less backdrop
# plus a 4KB overlay cropped from this file; this 1.5MB original is only needed
# locally by tools/build-alchemy-pen-overlay.py, so it stays in git but not in the deploy.
images/before-times/absurd-alchemy-clean-v4.webp

# PNG is the working/source format for this site's generated art; WebP is what
# ships. Only the three PNGs below are actually served, so a new source PNG dropped
# into images/ is kept out of the deploy automatically — no list to maintain.
# If you ever add a PNG that must be public, add a !re-include line for it here,
# or it will 404. (~132MB of source art, still in git and still syncing.)
images/**/*.png
!images/aiw/aiw1.png
!images/before-times/knowledge-maze/knowledge-answer-arrives-v1.png
!images/before-times/knowledge-maze/knowledge-answer-exists-v1.png

# Unused archives & OS noise
images/archive/
.DS_Store
**/.DS_Store

# Before Times working material. bt-assets is a slushpile of source assets kept in
# git so it syncs across machines, but only the few files the site actually links to
# need to reach the deploy — mocap GIFs and the Sisters Hayes PDFs, ~4MB of ~526MB.
# Same shape as the OMAxAI/* rule above: exclude the children, re-include the two
# directories that are served. (Excluding "bt-assets/" itself would make the
# !re-includes below impossible — a path under an excluded directory can't come back.)
bt-assets/*
!bt-assets/mocap
!bt-assets/The Sisters Hayes - short

# Sisters Hayes: only the scrubbed PDFs are served. The .fdx sources still
# carry personal contact info on their title pages, and The Assistant docs
# are a different unreleased project.
*.fdx
bt-assets/The Sisters Hayes - short/The Assistant*.docx
# Nick's read-through notes: nothing links to them, and "only the scrubbed PDFs
# are served" above should be literally true. Delete this line to publish them.
bt-assets/The Sisters Hayes - short/nicks-notes-on-the-sisters-hayes.rtf
