# Keep private working material and dev tooling out of the public deploy.
# Syntax follows .gitignore rules; !patterns re-include.

# Talk decks & WIP material — only viewer/ is served (via /s2i-present rewrite)
OMAxAI/*
!OMAxAI/viewer

# Dependencies & dev tooling (no build step runs on Vercel)
node_modules
**/node_modules
package.json
package-lock.json
tools/
# transcripts/*.md sources stay private via the *.md rule below; the
# pre-rendered .html fragments in transcripts/ ARE served (article reader
# fetches them), and an unanchored "transcripts/" here would also swallow
# images/transcripts/ (gitignore patterns match at any depth).
.lighthouse/
*.sh
*.code-workspace
tsconfig.json

# Docs, prototypes, legacy config
*.md
.htaccess
og-image.html
border-shape-lab.html
before-times-box-prototype.html

# Game source (ChessBlaster serves from dist/ only)
games/ChessBlaster/src
games/ChessBlaster/build
games/ChessBlaster/public
games/ChessBlaster/vite.config.ts

# Unused archives & OS noise
images/archive/
.DS_Store
**/.DS_Store
