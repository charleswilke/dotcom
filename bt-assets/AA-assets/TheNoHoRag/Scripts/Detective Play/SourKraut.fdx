      <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="0.50" RightIndent="8.00" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier New" RevisionID="0" Size="12" Style=""></Text>
        <Tabstops>
          <Tabstop Position="1.25" Type="Left"/>
        </Tabstops>
      </Paragraph>
      <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="0.50" RightIndent="8.00" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier New" RevisionID="0" Size="12" Style="">PROPERTY PLOT</Text>
        <Tabstops>
          <Tabstop Position="1.25" Type="Left"/>
        </Tabstops>
      </Paragraph>
      <Paragraph Alignment="Full" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="8.00" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier New" RevisionID="0" Size="12" Style="">Two desks, one for the detective adorned with a simple desk lamp, and larger than the one for the assistant. Lucile's desk will not be much larger than the typewriter that sits on top. Three chairs, one for Lucile, two surrounding the detective's desk. Double Bass. Package containing vial filled with green liquid. Backdrop of wood paneling with armature to hang it from. Three guns. Two glasses and a bottle of bourbon.</Text>
        <Tabstops>
          <Tabstop Position="1.25" Type="Left"/>
        </Tabstops>
      </Paragraph>
    </Content>
