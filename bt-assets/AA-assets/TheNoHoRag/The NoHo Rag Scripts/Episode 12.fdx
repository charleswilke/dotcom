<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="2">

  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALEC"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. NEws Studio</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(stern as shit)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fuck you. Let’s go to the news.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec kicks his head to the side. The camera instinctively follows.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Beleaguered local artist Patrick </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Shonesse</Text>
      <Text> is attempting...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Again...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>To complete his opus retelling of </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Finnegans</Text>
      <Text> Wake, in and around NoHo.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec aggressively points to the screen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Watch!</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Finnegan’s Wake</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>fade to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALEC"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Studio</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec is taken aback.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh... Man...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>When it’s not a cop doing the killing, it’s almost shocking!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>In other shocking news...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The supreme court heard oral arguments on the constitutionality of gay marriage.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We reached out to Judge </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Ginsburg</Text>
      <Text> for comment, but we were told she was on vacation.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But our crack team found her via </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">instagram</Text>
      <Text> and we sent our whipping boy to South Beach.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="7/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOY"></CharacterArcBeat>
          <CharacterArcBeat Name="RBG"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. poolside</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A microphone is thrust in RBG’s face</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Boy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Justice </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Ginsburg</Text>
      <Text>, what are your thoughts on the gay marriage case.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">RGB</Text>
      <Text> is dismissive.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RBG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I love them, now shoo </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">shoo</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The boy thrusts the microphone back in her face.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Boy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But, are you worried about conservative opposition?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RBG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look, I got </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Scallia</Text>
      <Text> wrapped around my little finger on this one.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And they’re arguments are:</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>RBG shrugs and waves her hands uncontrollably in front of her to signify the ‘nothing’ that the conservatives have to argue with.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>boy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Please don’t ever die.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RBG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Don’t intend to, honey.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>RBG does a heroic wink into the camera.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Freeze frame. Good bad and Ugly sound.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALEC"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News STUDIO</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec sits proud.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>RBG and the Queen are gonna out live us all...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec pulls up a can of beer, cracks it open, and loudly swigs a long swig. Then puts it below the desk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And finally tonight: Bernie Sanders</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(boxing announcer voice)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The independent firebrand from Vermont. The senator who won’t take your bullshit. The New York Jew with attitude!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is running for president.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes, he’s the candidate with the most fiscally responsible haircut since Van Buren, and an honest to god Socialist. </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And damn proud of it.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Here tonight, by popular demand. Stu Baker with another Stu Brewed Beat.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="3" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. News STUDIO</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Stu sits Indian style on the desk holding bongos, with a black backdrop behind.</Text>
    </Paragraph>
  </Content>

