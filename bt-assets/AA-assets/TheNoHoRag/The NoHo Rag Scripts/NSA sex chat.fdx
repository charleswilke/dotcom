<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="2">

  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 3/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ANNOUNCER"></CharacterArcBeat>
          <CharacterArcBeat Name="GUY"></CharacterArcBeat>
          <CharacterArcBeat Name="VERONICA"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Bedroom</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>MUSIC STINGER</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Lit </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">sexily</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>VERONICA lays on the bed... </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">sexily</Text>
      <Text> talking on the phone.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Announcer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’ve tried the other sex chat lines. Now try this one, ya old horn dogs! It’s the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">HoneyPot</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">HotLine</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This here is Veronica. She works a demanding nine-to-five. Sometimes, she takes her work home with her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Veronica</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I just had the steamiest conversation with Trevor from Cleveland, he likes girls who lick asshole.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He was good, but I want more.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Veronica puts the phone back up to her ear.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ANNOUNCER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And now she wants to talk to you!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>veronica</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(throaty)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Hiiiiiiiiiiii</Text>
      <Text>.....</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Guy (o.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Uhh</Text>
      <Text>. Hello?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>veronica</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey there, stud supreme with sour cream.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>GUY (o.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Who is this?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>veronica</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What’s more important is what I’m wearing.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You recently searched </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Google</Text>
      <Text> for silk teddies.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>GUY (o.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(confused)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What? No? Wait. How do you know that?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Veronica</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can you verify that your social security number is-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Announcer cuts off Veronica as she mouths the numbers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Announcer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>These sexy ladies are ready to chat... About your search history.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Guy (o.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How the hell did you know that? Who is this?</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="5/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ANNOUNCER"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Balcony</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Veronica dances wearing a navy windbreaker as announcer finishes the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">hotline’s</Text>
      <Text> details.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ANNOUNCER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Get ready to chat with our sexy professionals. We have women around the clock calling! We’ve got your number, your search history </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">and</Text>
      <Text> we know just what you’re into.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How, you ask?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Veronica turns her back to the camera and the NSA yellow letters are clearly visible.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Announcer (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(boldly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Because we’re the NSA. And we’re starting to get weird.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>NSA logo.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ANNOUNCER (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Your deepest desires. Our paperwork.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Fade out.</Text>
    </Paragraph>
  </Content>

