<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="2">

  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Ext. News Footage - Protests</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Large groups of protesters with Anti-Alec signs:</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Fuck Me? Fuck you!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Anti-Alec logos</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Oh NoHo You Didn’t!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Free The Nipple (With Don’t stamped on top)</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3 5/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALEC"></CharacterArcBeat>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Producer Bob’s office</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>BOB is sitting, watching YouTube footage of the Alec Protests.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob’s holding a Magic 8 Ball, shaking it with fear.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob gulps.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Then he flips the Magic 8 Ball and looks down at it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>INSERT: Ask Again Later.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dammit!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fine.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Then he throws it off to the side as there’s a thud at the door.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec (o.s.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(muffled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The fuck?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob gets up and unlocks the door.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Since when did you start locking your door?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob looks like a surprised bird.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Since </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">you</Text>
      <Text>, Alec.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Since the last time I saw you</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Standing right there.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And you...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec waves Bob off and enters the office.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec sits at Bob’s desk and throws his legs up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Alec</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Alright, when can I start telling the news again?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You CAN’T, Alec.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But I’m right!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You were fired.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec waves it off.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m a Reidel.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">ARE</Text>
      <Text> terminated.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec still just doesn’t get it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Kicked to the curb.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It didn’t work out!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We found someone else!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec stands abruptly and leans in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AlEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You what?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Bob?!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob looks down and draws with his finger on his desk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look, I just don’t need the kind of stress you seem to welcome upon me with such striking reliability day in and day out.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec doesn’t let Bob’s information sink in.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Who are they?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob looks up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A hotshot duo out of Des Moines, Alec.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec looks shocked.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A duo?!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Iowa?!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob nods.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dane Argyle and Kelly Mae Globerman.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They poll well in a very similar demographic.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How similar?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Close.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ish.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Shit.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’ve been replaced.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was right!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Not for seven o’clock.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was right!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You started an episode by saying “Fuck You!”</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It was a term of endearment!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It was an FCC violation!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you know how much the fine was?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you?!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>$27,500.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>To hell with the FCC.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was right.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob throws his arms up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It doesn’t matter.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec collapses into the chair and looks to the ground.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to himself)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Doesn’t matter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah, and you gotta go. They’re about to get here and I don’t need the protesters who followed you attacking them.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Alec gets up, dejected and walks out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ALEC</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Doesn’t matter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Make it matter, my friend.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Make it matter.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Macy’s</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>DANE and KELLY MAE arrive outside. They pause. Dane looks to Kelly Mae.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, this is a step up!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae looks disgusted.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s a damn big station.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Think they’re compensating for something?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane confirms bluntly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh yeah.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>SMASH TO BLACK</Text>
    </Paragraph>
  </Content>

