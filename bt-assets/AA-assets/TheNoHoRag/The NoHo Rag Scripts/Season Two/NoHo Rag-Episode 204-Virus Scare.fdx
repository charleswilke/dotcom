<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="2">

  <Content>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Fade in:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="OLIVIA"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Writer’s room - Day</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>BOB fidgets with items on shelves, as he does. Then reaches for a tissue just in time to catch a massive SNEEZE.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>OLIVIA is pecking away at her keyboard, she turns when Bob sneezes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Coming down with something?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(clearly stuffy)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh no, I’m fine!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Never felt better!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>OLIVIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh good, because if you had whatever’s going around, I’d hope you would have the good sense to stay home.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, I’m not sick.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I can’t be sick.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This weekend is The twenty sixteen Pacific Lifestyle and Leisure show.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Olivia stares at Bob blankly.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob scoffs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s only this region’s premiere foodie and fun expo!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I go every year!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Olivia stares blankly at Bob.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to himself)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I can’t be sick.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob blows his nose again or coughs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">not</Text>
      <Text> sick.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>TITLE CARD</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="5/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Desk</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane and Kelly Mae rock the news:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly MAe</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Good evening, I’m Kelly Mae Greenblatt.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I’m Dane Argyle.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">VIRUS SCARE</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you have it? You might!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s right, NoHo citizens are in the grips of the extremely contagious Acute Pneumococcal Alpaca Fever.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This newly discovered communicative and antibiotic-resistent disease spreads fast and incubates in the system for three weeks.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Desk - Behind the camera</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob’s eyes grow wide.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>CUt to:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For those unfamiliar with the symptoms. It begins similar to a common cold.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sniffling.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="3" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. News Desk - Behind the camera</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob sniffles.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Desk</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Coughing.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="3" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. NEws Desk - Behind THE CAMERA</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob first looks around and sheepishly coughs.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Desk</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And projectile vomiting.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="3" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. News Desk - Behind the camera</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob’s eyes grow as wide as saucers as he grips his script. He nervously grabs his chest/stomach and test heaves with concerned eyes.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News DESK</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The CDC is now investigating the root cause and exploring immunization options because while this is currently regional, it is feared it may soon spread across the nation.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Doctor Elias Harold of the CDC released this statement earlier today.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ELIAS"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. CDC statement package - On Green</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Standard trappings of a press conference.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>DOCTOR ELIAS HAROLD stands at the podium in a LAB COAT.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Elias</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We are uncertain at this time how this disease jumped from the Alpaca to humans. We now have our smartest minds working around the clock searching for a cure.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>In the meantime, it is important to avoid human contact with people exhibiting the listed symptoms.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Those suffering are contagious for three weeks from onset. And remember this is an airborne disease. Which means it can be spread without direct contact. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Peanut gallery erupts. Elias calms the crowd.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ElIAS (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This is all the information we have at this time.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But, if you feel ill and you have plans...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Cancel them and stay home.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Desk - Behind THE CAMERA</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob is noticeably sweating.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh no...</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 4/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Desk</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Scary stuff there, </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">KM</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And here I thought I’d only ever see acute alpaca at the petting zoo.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae nods.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I know where I’ll be this weekend...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Staying inside.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We’ll be right back after these messages.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Paraflix</Text>
      <Text> commercial audio plays in the background while Kelly Mae and Dane sit at the desk with the green screen clearly visible.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob stands staring into the middle distance, sweating.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane chats with Kelly Mae.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I tell you, these animal illnesses...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If it’s not swine, it’s bird. Flu, fever. Something’s gonna wipe out the human race.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Might as well be the majestic alpaca.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane looks over to Bob. Dane scrutinizes Bob standing nervously, sweating.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So Bob, what do you got going on this weekend?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob slowly snaps to, and recognizes Dane’s question.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, I, uh...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Have, uh...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A leisure and-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob holds in a heave.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Lifestyle expo.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s uh...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob heaves again.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This region’s premiere foodie and fun...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane’s attention turns to the feed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hold that thought, Bob!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The new comptroller campaign commercials are on!</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 1/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="EUGENE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Park - Eugene’s Ad - Day</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>EUGENE </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">KNOTTS</Text>
      <Text> walks through a grassy knoll and comes to a stop with a garbage can in the mid background. Bucolic MUSIC plays.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Eugene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello there, I’m Eugene </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Knotts</Text>
      <Text>, retired pediatrist.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I’m running for your vote as NoHo’s next comptroller.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If you’re like me. You love a good park day.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But NoHo’s parks are in need of a little revitalization.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We’ve been kicking that can down the road for far too long.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Eugene laughs.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A BUM wanders into the background of the shot and begins rummaging in the garbage can. Eugene doesn’t notice.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>EugeNE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s why I’m releasing my plan to reinvigorate NoHo’s parks and walking trails.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>As your comptroller I will take the necessary steps to make our existing parks safe.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And add a few more parks as we </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">skeedaddle</Text>
      <Text> into the future!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The BUM begins eliciting the same symptoms as described earlier. Eugene turns back to address the bum.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>EuGENE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to Bum)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Neighbor.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Eugene looks back to the camera.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>EUGENE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Walk with me, </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">NoHo</Text>
      <Text>, won’t you?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">ONSCREEN:</Text>
      <Text> Standard “This Commercial Paid For” information.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BLAKE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. North Victory - Blake’s Ad - Day</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Blake stands in a dilapidated part of town.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Blake</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>North Victory has been a blemish on this beautiful city for as long as </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">this guy’s</Text>
      <Text> been around!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But it doesn’t have to be that way anymore!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sup guys!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Blake Pearson here, former Real World cast member and proud trust fund baby!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I want to be your next comptroller because I think North Victory is worth saving!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How? You ask?</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BLAKE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INt. Construction Site - Green Screen</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Blake</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>BEER!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We are standing at ground zero of the new </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Cahuenga</Text>
      <Text> Valley Brewery, Restaurant, and entertainment fun zone!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This, of course, is merely stage one in my comprehensive revitalization plan to turn blight into a blast!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If elected, I will flex the power of comptroller and bring other businesses to North Victory- </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Provided they have signed my commitment pledge...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Together, we will make </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">NoHo</Text>
      <Text> great again!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This Ad paid for by me!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And just a couple of my friends...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Legalize scrolls at great length across the screen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Blake (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do I support this message?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You tripping? Please...</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="8" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>TITLE CARD</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. NEWs Desk</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Welcome back, NoHo.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Or... At least those of you who aren’t projectile vomiting.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae bristles.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well that’s our show for tonight, I’m Kelly Mae Greenblatt. Stay safe out there NoHo.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I’m Dane Argyle. Coming up next: a rerun of the South West regional Parcheesi championships.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Good night and death to Alpacas.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 6/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Break Room - After the show</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob is adding honey to his tea. Kelly Mae enters and begins fidgeting with her own snack.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I just know I’m gonna catch this damn alpaca fever.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob instantly tenses.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly MAE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It happens every time...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m going to run into some old friend at the super market, and I’m gonna have to hug her.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Or at the gym.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s coming for me, I can feel it.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Then it’s three weeks of hell, Bob.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob tenses more.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I just never notice the symptoms.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And even if I do, it’s too late.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I mean everybody’s sniffling!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob sniffles and Kelly Mae’s mouth drops open like she just figured out the killer in a whodunit. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You were coughing during the break!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh no, Bob.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob looks suspect.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Bob, you don’t have it...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(raspy)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Of course not. Kelly -</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob heaves.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>...Mae.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’ve already got my tickets to the Pacific Leisure and Lifestyle expo this weekend.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s food and...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">...fun</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob holds still for a second and looks wildly concerned.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Bob, if you go to that, you’re going to throw up all the food and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">no one’s</Text>
      <Text> going to have </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">any</Text>
      <Text> fun.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You will be patient zero.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I need to leave, because I already feel it coming on.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae exits.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob is left staring intently into the middle distance. Then Bob exclaims Wrath-of-Khan style:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">LEISURE</Text>
      <Text>!!!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Smash to black.</Text>
    </Paragraph>
  </Content>

