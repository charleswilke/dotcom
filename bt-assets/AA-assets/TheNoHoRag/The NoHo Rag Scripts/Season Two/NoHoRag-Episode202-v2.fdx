<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="2">

  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 6/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="OLIVIA"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Writer’s Room</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob flips through binders. Shifts boxes from cubby hole to cubby hole. Paces. Scratches his head. Then looks over to the desk on the other side of the room.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Sitting lifelessly, OLIVIA stares blankly at Bob.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is it five yet?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We have new anchors now!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They will read what you write!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They need what you write.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They need </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">you</Text>
      <Text>, Olivia.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For once!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know how many segments I got on the air with Alec?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob looks with a smirk to the ceiling.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was a fan of your game boy retrospective.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>OLIVIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>One!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob keeps looking off to the ceiling.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It really was the best system.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>OLIVIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>One, Bob!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>In almost two years!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob looks somberly back at Olivia.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well you got your wish. Alec is gone.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But Alec.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>... Kinda did all our jobs...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So now, it’s time to do the jobs we were hired for.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The jobs we’re getting paid for?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>OLIVIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Does this mean we can cover the stories we want now?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Uhh</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sure.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob and Olivia nod. Olivia turns back to her desk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just no nudity.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Deal?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Olivia doesn’t hear Bob. She obsessively stares at her computer screen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>At last.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My reign begins!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>SMASH TO: TITLE CARD</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. News Desk</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane and Kelly Mae do what they came here to do. News time:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Good evening.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Am Dane Argyle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I’m Kelly Mae </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Greenblat</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tonight. NoHo civilians headed out to the polls to replace Wilson </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">DiNapoli</Text>
      <Text>, the NoHo Comptroller.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Whom you may recall two weeks ago gave an expletive laden surprise resignation speech.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The two candidates receiving the most votes will now face off in the general election later this year.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You mean we’ll have to vote again?!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes, Dane. It said that on the ballot.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But that church smelled weird!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane throws his arms up and looks annoyed.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KellY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We now go live to the first winner’s campaign headquarters. Where Eugene </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Knotts</Text>
      <Text>, that little sweetheart, is preparing to take the stage.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="EUGENE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Campaign headquarters - On Green</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>EUGENE </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">KNOTTS</Text>
      <Text> is half Don </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Knotts</Text>
      <Text> and half Mr. Rogers. He stands in suit and tie and attempts to hush cheers. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He begins to remove his suit jacket and reveals a cardigan.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Eugene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello, there!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thank you!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thanks everybody!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Eugene reaches off camera for a warm glass of milk.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>He pulls one hand away quickly and shakes it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Eugene (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Ooh</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Warm!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Eugene addresses the crowd.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>EUGENE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, folks!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m just so happy we did it!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We’re gonna keep on pushing.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And we’re gonna win that little old election later this year...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And we’re gonna clean up our town!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Audience erupts!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>EUGENE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thank you, guys!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Eugene yawns endearingly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>EUGENE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Ok</Text>
      <Text>, off to bed...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Eugene turns and walks off.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Noho STudios - News Desk</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Two shot.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Adorable.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And now we go to the headquarters of the other big winner of the evening, Blake Pearson.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Notable for spending a record amount on his runoff campaign. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BLAKE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Campaign Headquarters - Green Screen</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Campaign headquarters is lively. Like a rave. Blake Pearson takes the stage. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Blake</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Whoo</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Alright NoHo!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The audience calms.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Blake (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Everybody got your complimentary vitamin water?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, raise them high!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For today we are victors!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And in the upcoming general election, we will be champions!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And to really help kick off our big campaign, we welcome our new corporate partner:</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A sign squeaks slowly down from the fly space. It shows the logo of:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BLAKE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The craft beer division of the Cahuenga Valley Brewing Company, </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">LLC</Text>
      <Text> </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Cheers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BLAKE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now let’s launch this big campaign the best way THIS CANDIDATE know how:</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>With victory tote bags, graciously provided by Fossil.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Blake’s voice snaps to a standard Ad Announcer voice:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BLAKE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For when you first get a day job.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fossil.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 3/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Noho Studios - News DESK</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Two shot.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane looks at his watch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hmm...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Kelly Mae, what exactly is a run off election?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae turns, almost excited at Dane’s banter ability.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s a preliminary election where the two candidates who get the most votes then move on to the general election.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So, we’ll be seeing a lot more of those two.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ah interesting.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, run off means something a little different.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>To me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Okay.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And there’s nothing preliminary about it!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dane.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It just happens.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Okay well, from everyone here at NoHo</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mostly after a spicy meal.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m Kelly Mae-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">always</Text>
      <Text> burns.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Greenblatt.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I’m Dane Argyle.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Good luck. And good evening.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 3/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Reverse angle of news desk</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob does his standard sigh of relief even though it kind of ended rocky.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane walks past.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Good show everybody.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Take note.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s how you tell the news.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob stops Dane at the end of his sentence.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dane.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah, Bob.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I need to talk to you about how you tell the news.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Great!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dane.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Notes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You have to-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Love it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If you would just-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Love it, Bob!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah, great.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Please avoid colorful references to bowel movements during the sign off.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like I’ve told you...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Right right.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, sometimes it just spills out of me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BOB</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah like that.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No more.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <ScriptNote Color="#000000000000" DateModified="20151215T002314" DateTime="20151215T002314" Name="" Type="">
        <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
        </Paragraph>
      </ScriptNote>
      <Text>Ten-Four.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane walks off.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob shakes his head.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 3/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Alley behind studio</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae walks to her car and begins loading it. Dane follows shortly there after and </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">siddles</Text>
      <Text> up behind her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Great job in there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane makes a check in the air.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Public: Informed</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae spins and faces Dane.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KellY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah. Informed about your regularly unpleasant digestive issues.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DaNE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey. Bob says </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">adlib</Text>
      <Text>, I talk about what I know.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, learn something else.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Scrapbooking</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Macramae</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sports!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Something! Anything!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just not poop.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hmm, they loved it back in Des Moines.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae does a whole body sigh and drops her head into her hand.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look Dane, you brought us all the way out here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Big Hollywood News.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">North</Text>
      <Text> Hollywood. Not Hollywood. Which I’m now learning are two strikingly different places.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Still a step up from Des Moines.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was perfectly happy there.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly points at Dane and presses her index finger into his chest.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KelLY MAE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">You</Text>
      <Text>, if you recall, gave a drunken and damned convincing call to arms...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane looks off to the horizon proudly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Made me agree to uproot my life in Des Moines.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane scoffs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DaNE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Life in Des Moines?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>There wasn’t much life to uproot.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Look, Leon left you two years ago.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Since then, how often have you broken off plans after work for a night of white wine and </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">xanax</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane grabs Kelly Mae’s arms.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And we’re here!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane swings to Kelly Mae’s side throws one arm over her shoulder and reaches out his free hand to the horizon.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>One step closer.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>To Big.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hollywood.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>News.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae concedes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, it </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">is</Text>
      <Text> warmer here than Iowa.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And there </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">is</Text>
      <Text> a damn good pie shop two blocks from my apartment.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is this an invitation?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I just gotta stop home and let the dog out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, I love the BAJA Men.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Fade to black.</Text>
    </Paragraph>
  </Content>

