<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="2">

  <Content>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 2/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Noho Studios - DAy</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Artisinal shots of the gear: </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Coiled XLR cables. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Have you tried Salsa and Beer?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly MAe (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Individually? Yes.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Artsy shots of the light umbrellas.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No! The new joint on Sherman way!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They told me not to go north of Victory.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Close up of someone putting on a lav.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, you’re missing some great spicy Hispanic American faire, Kelly.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Damn shame.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAe (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’ll live.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Wiping down the clapboard.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Of course, I got the worst squirts of my life almost instantly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAe (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Of course.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Close up of scrolling through text.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yeah, I really don’t think it’s fair to pay for food I don’t </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">actually</Text>
      <Text> leave the restaurant with.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane taps his script on the desk.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Gross, Dane!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Jesus.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob stands next to the camera.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Alright everybody, calm on the set, stick to the script, everybody wins in three...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Two...</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>NoHo Title CArd</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="5/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. NoHo Studios</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Good evening. I’m Kelly Mae </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Greenblatt</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I’m Dane Argyle.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Santa Clause!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you really know him?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Because tonight, we have the NoHo Rag exclusive-</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Interview.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>With.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Santa.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Roll it!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob is smacked by Dane’s enthusiasm.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh Jesus...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(into headset)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Uh. r, roll it.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="SANTA"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Santa’s Package Interview</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Shot in the LIVING ROOM with chairs in middle of room, with the 50mm lens.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa sits with a tumbler of milk and pours a little bottle of brandy into his glass.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane Argyle sits across straightening his suit.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Ok</Text>
      <Text>, you can’t see how gassy I am right?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Bob?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa takes a sip.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Santa</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just let it out boy.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane acknowledges Santa and begins the interview.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Mister Claus, thank you for meeting with us today.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SANTA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like I have a choice.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’ve come under recent scrutiny for your cookie line.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Santa’s Secret Wafers.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>With a wink to camera, Santa:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SANTA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No cookies are fresher!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The commercial in particular.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SANTA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A gem!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane points to the ceiling.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I believe we have a clip.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="SANTA"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Santa’s Secret Wafers Commercial</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa sits in front of a brick fireplace.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Santa</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hello children, you want help getting off the naughty list!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, Santa’s got a little something for your taste buds!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa reaches into the box and</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Switch to 50mm.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa holds the walnut cookie at an angle so it looks like a vagina. He scoops it slowly through whipped cream with his face donning a creepy smile blurry in the back.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Santa (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Santa loves a creamy cookie.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa winks to camera.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="SANTA"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Title card shot selling the cookies</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A plate with cookies and hot cocoa with a heaping amount of whipped cream overflowing the side.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa reaches in a places a half-eaten cookie back on the table.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Santa (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can you keep our little secret?</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="SANTA"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Santa’S PACKAGE INTERVIEW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane stares down Santa, saying nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SANTA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Some lines may have been crossed.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>EXT. Dane Argyle’s Package</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane sitting on a park bench.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He admitted wrong doing.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Score one for Dane.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But something still-</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane swats furiously at a fly.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Felt.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Off.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Santa’S PACKAGE INTERVIEW</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane revs up for the big question.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>As far questions go.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>There’s just one.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>More.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What does Mrs. Clause think of all this?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Santa looks intense, then suddenly.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="5" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Breaking News Graphic</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="5/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>BReaking news - At the desk</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae sits tall while Dane looks disappointed. Cut to one shot of Kelly Mae.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This just in. The NoHo Comptroller is about to give a surprise press conference. We will join them live momentarily.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Back to two-shot:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s controller, Kelly Mae.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nope. No it isn’t.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>DANE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I have three of them for my </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Sega</Text>
      <Text> Genesis.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KELLY MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dane, that’s enough.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And now we go live to the press conference!</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>Cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="WILSON"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Press Briefing Room</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>WILSON </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">DiNAPOLI</Text>
      <Text> whistles as he nearly skips to the podium. With a content grin, he waves the crowd silent. Flashes light his HORN RIMMED GLASSES.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Wilson</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>People of NoHo!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m out!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I have faithfully served as </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline">your</Text>
      <Text> comptroller for 26 years, and I have got to say...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(incredulous)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Y’all do not know how to keep a budge-et!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Gasps from the peanut gallery.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Wilson (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I keep </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline">forecasting</Text>
      <Text> that we’ll maintain a budget surplus.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>But every time y’all.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Every time.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’ve failed me.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So now you may all go to hell, and I will go to San Pedro, where I will be starting </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline">my own</Text>
      <Text> business selling Orange Juice to thirsty dock workers.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Wilson flips two birds and motors.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 4/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BOB"></CharacterArcBeat>
          <CharacterArcBeat Name="DANE"></CharacterArcBeat>
          <CharacterArcBeat Name="KELLY MAE"></CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. NohO STUDIOS</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane and Kelly Mae sit mouth agape. Bob stands mouth agape.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob snaps into action:</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">adlib</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Adlib</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Adlib</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob gets frustrated.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Freaking </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">adlib</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Dane acknowledges Bob, then turns to Kelly Mae.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, did you see that curtain?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What was that, velvet?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae drops her head into her hands.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly MAE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>God...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae gets frustrated.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>KellY MAE (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You convinced me to come out here, Dane!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Big Hollywood news, you said.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This city is screwed, Dane!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob freaks.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Just wrap it up!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>As he wrings his script.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Dane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For all of us here in NoHo, good luck, and good evening.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Kelly Mae drops her head quickly.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(sotto)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Jesus, Dane.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>She regains composure all in one quick motion and focuses on the camera.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Kelly MAe (CONT’D)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I’m Kelly Mae</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Greenblatt</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Y’all have a good night.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Bob stands by the camera. Hand on hip, rubbing head. </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Facepalm</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Bob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(beat)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>At least there was no nudity.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>END.</Text>
    </Paragraph>
  </Content>

