{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "space-toots",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((q,r)=>{require('fs').readFile('.'+q.url.split('?')[0].replace(/\\/$/,'/index.html'),(e,d)=>{r.writeHead(e?404:200,{'Content-Type':'text/html'});r.end(e?'Not found':d)})}).listen(3000)"],
      "port": 3000
    }
  ]
}
