{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "space-toots",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const m={'.html':'text/html','.js':'application/javascript','.css':'text/css','.mp3':'audio/mpeg','.ogg':'audio/ogg','.wav':'audio/wav','.png':'image/png','.jpg':'image/jpeg','.json':'application/json'};h.createServer((q,r)=>{let u='.'+q.url.split('?')[0];if(u.endsWith('/'))u+='index.html';const t=m[p.extname(u)]||'application/octet-stream';f.readFile(u,(e,d)=>{r.writeHead(e?404:200,{'Content-Type':t});r.end(e?'Not found':d)})}).listen(3000)"],
      "port": 3000
    }
  ]
}
