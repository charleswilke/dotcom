{
  "buildCommand": "node tools/minify-css.js styles.css subpages.css before-times.css && node tools/minify-js.js main.js common.js nav.js before-times.js before-times-archive.js karaoke.js",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://player.vimeo.com https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://substackcdn.com https://substack-post-media.s3.amazonaws.com https://substack-video.s3.amazonaws.com; media-src 'self' https://charleswilke.substack.com https://substack-video.s3.amazonaws.com; connect-src 'self' https://api.rss2json.com https://api.allorigins.win https://tootsjam-scores-api.charleswilke.workers.dev; frame-src 'self' https://player.vimeo.com https://www.youtube.com https://www.youtube-nocookie.com https://charleswilke.substack.com"
        }
      ]
    },
    {
      "source": "/:folder(images|audio|games)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*\\.(webp|png|jpg|jpeg|gif|ico|mp3|mp4|mov|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/tootsjam", "destination": "/tootsjam/", "permanent": true },
    { "source": "/chessblaster", "destination": "/chessblaster/", "permanent": true },
    { "source": "/before-times/sound-stage(/?)", "destination": "/before-times/screening-room", "permanent": true }
  ],
  "rewrites": [
    { "source": "/read/:slug", "destination": "/api/article-preview?slug=:slug" },
    { "source": "/read/:slug/", "destination": "/api/article-preview?slug=:slug" },
    { "source": "/s2i(/?)", "destination": "/s2i.html" },
    { "source": "/s2i-present(/?)", "destination": "/OMAxAI/viewer/index.html" },
    { "source": "/before-times/screening-room(/?)", "destination": "/before-times-screening-room.html" },
    { "source": "/before-times/game-development(/?)", "destination": "/before-times-game-development.html" },
    { "source": "/before-times/content-factory(/?)", "destination": "/before-times-content-factory.html" },
    { "source": "/before-times/knowledge-maze(/?)", "destination": "/before-times-knowledge-maze.html" },
    { "source": "/before-times(/?)", "destination": "/before-times.html" },
    { "source": "/mixtape(/?)", "destination": "/mixtape.html" },
    { "source": "/bsides(/?)", "destination": "/bsides.html" },
    { "source": "/side-two(/?)", "destination": "/side-two.html" },
    { "source": "/mixtape-side-two(/?)", "destination": "/mixtape-side-two.html" },
    { "source": "/gwor(/?)", "destination": "/gwor.html" },
    { "source": "/junkyard-cabaret(/?)", "destination": "/junkyard-cabaret.html" },
    { "source": "/grief-without-ritual(/?)", "destination": "/grief-without-ritual.html" },
    { "source": "/tootsjam/:path*", "destination": "/games/TootsJam/:path*" },
    { "source": "/tootsjam/", "destination": "/games/TootsJam/tootsjam.html" },
    { "source": "/spacetoots(/?)", "destination": "/games/SpaceToots/index.html" },
    { "source": "/spacetoots/:path*", "destination": "/games/SpaceToots/:path*" },
    { "source": "/chessblaster(/?)", "destination": "/games/ChessBlaster/dist/index.html" },
    { "source": "/chessblaster/:path*", "destination": "/games/ChessBlaster/dist/:path*" }
  ]
}
