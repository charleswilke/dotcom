{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://charleswilke.substack.com https://substack.com; script-src 'self' 'unsafe-inline' https://player.vimeo.com https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://tootsjam-scores-api.charleswilke.workers.dev; frame-src 'self' https://player.vimeo.com https://www.youtube.com https://www.youtube-nocookie.com"
        }
      ]
    },
    {
      "source": "/:folder(images|audio|games)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*\\.(webp|png|jpg|jpeg|gif|ico|mp3|mp4|mov|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/writing-archive.html", "destination": "/writing-archive", "permanent": true },
    { "source": "/writing-archive/", "destination": "/writing-archive", "permanent": true },
    { "source": "/junkyard-cabaret.html", "destination": "/junkyard-cabaret", "permanent": true },
    { "source": "/junkyard-cabaret/", "destination": "/junkyard-cabaret", "permanent": true },
    { "source": "/l.ai.bor.html", "destination": "/l.ai.bor", "permanent": true },
    { "source": "/l.ai.bor/", "destination": "/l.ai.bor", "permanent": true },
    {"source": "/audio/grief-without-ritual/from-the-beginning.mp3", "destination": "/audio/exploring-laibor-mixtape/from-the-beginning.mp3", "permanent": true},
    {"source": "/audio/grief-without-ritual/from-the-beginning.scope.bin", "destination": "/audio/exploring-laibor-mixtape/from-the-beginning.scope.bin", "permanent": true},
    {"source": "/lyrics/grief-without-ritual/from-the-beginning.json", "destination": "/lyrics/exploring-laibor-mixtape/from-the-beginning.json", "permanent": true},
    {"source": "/songs/gwor/from-the-beginning(/?)", "destination": "/songs/mixtape-side-two/from-the-beginning/", "permanent": true},

    {"source": "/audio/grief-without-ritual/waiting-for-something.mp3", "destination": "/audio/exploring-laibor-mixtape/waiting-for-something.mp3", "permanent": true},
    {"source": "/audio/grief-without-ritual/waiting-for-something.scope.bin", "destination": "/audio/exploring-laibor-mixtape/waiting-for-something.scope.bin", "permanent": true},
    {"source": "/lyrics/grief-without-ritual/waiting-for-something.json", "destination": "/lyrics/exploring-laibor-mixtape/waiting-for-something.json", "permanent": true},
    {"source": "/songs/gwor/waiting-for-something(/?)", "destination": "/songs/mixtape-side-two/waiting-for-something/", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/slow-the-clock.mp3", "destination": "/audio/grief-without-ritual/slow-the-clock.mp3", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/slow-the-clock.scope.bin", "destination": "/audio/grief-without-ritual/slow-the-clock.scope.bin", "permanent": true},
    {"source": "/lyrics/exploring-laibor-mixtape/slow-the-clock.json", "destination": "/lyrics/grief-without-ritual/slow-the-clock.json", "permanent": true},
    {"source": "/songs/mixtape-side-two/slow-the-clock(/?)", "destination": "/songs/gwor/slow-the-clock/?v=20261011", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/clear-as-day.mp3", "destination": "/audio/grief-without-ritual/clear-as-day.mp3", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/clear-as-day.mp4", "destination": "/audio/grief-without-ritual/clear-as-day.mp4", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/clear-as-day.scope.bin", "destination": "/audio/grief-without-ritual/clear-as-day.scope.bin", "permanent": true},
    {"source": "/lyrics/exploring-laibor-mixtape/clear-as-day.json", "destination": "/lyrics/grief-without-ritual/clear-as-day.json", "permanent": true},
    {"source": "/songs/mixtape-side-two/clear-as-day(/?)", "destination": "/songs/gwor/clear-as-day/", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/permission-to-ache.mp3", "destination": "/audio/grief-without-ritual/permission-to-ache.mp3", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/permission-to-ache.mp4", "destination": "/audio/grief-without-ritual/permission-to-ache.mp4", "permanent": true},
    {"source": "/audio/exploring-laibor-mixtape/permission-to-ache.scope.bin", "destination": "/audio/grief-without-ritual/permission-to-ache.scope.bin", "permanent": true},
    {"source": "/lyrics/exploring-laibor-mixtape/permission-to-ache.json", "destination": "/lyrics/grief-without-ritual/permission-to-ache.json", "permanent": true},
    {"source": "/songs/mixtape-side-two/permission-to-ache(/?)", "destination": "/songs/gwor/permission-to-ache/", "permanent": true},
    { "source": "/tootsjam", "destination": "/tootsjam/", "permanent": true },
    { "source": "/chessblaster", "destination": "/chessblaster/", "permanent": true },
    { "source": "/spacetoots", "destination": "/spacetoots/", "permanent": true },
    { "source": "/spacetoots/index.html", "destination": "/spacetoots/", "permanent": true },
    { "source": "/games/SpaceToots", "destination": "/spacetoots/", "permanent": true },
    { "source": "/games/SpaceToots/", "destination": "/spacetoots/", "permanent": true },
    { "source": "/games/SpaceToots/index.html", "destination": "/spacetoots/", "permanent": true },
    { "source": "/before-times/sound-stage(/?)", "destination": "/before-times/screening-room", "permanent": true },
    { "source": "/alice-in-wonderland/", "destination": "/alice-in-wonderland", "permanent": true },
    { "source": "/jersey-boys/", "destination": "/jersey-boys", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about(/?)", "destination": "/about.html" },
    { "source": "/writing-archive(/?)", "destination": "/writing-archive.html" },
    { "source": "/read/:slug", "destination": "/api/article-preview?slug=:slug" },
    { "source": "/read/:slug/", "destination": "/api/article-preview?slug=:slug" },
    { "source": "/s2i(/?)", "destination": "/s2i.html" },
    { "source": "/s2i-present(/?)", "destination": "/OMAxAI/viewer/index.html" },
    { "source": "/before-times/screening-room(/?)", "destination": "/before-times-screening-room.html" },
    { "source": "/before-times/game-development(/?)", "destination": "/before-times-game-development.html" },
    { "source": "/before-times/content-factory(/?)", "destination": "/before-times-content-factory.html" },
    { "source": "/before-times/knowledge-maze(/?)", "destination": "/before-times-knowledge-maze.html" },
    { "source": "/before-times(/?)", "destination": "/before-times.html" },
    { "source": "/l.ai.bor", "destination": "/generated/share-pages/l.ai.bor.html" },
    { "source": "/faq(/?)", "destination": "/faq.html" },
    { "source": "/alice-in-wonderland", "destination": "/alice-in-wonderland.html" },
    { "source": "/jersey-boys", "destination": "/jersey-boys.html" },
    { "source": "/mixtape(/?)", "destination": "/mixtape.html" },
    { "source": "/bsides(/?)", "destination": "/bsides.html" },
    { "source": "/side-two(/?)", "destination": "/side-two.html" },
    { "source": "/mixtape-side-two(/?)", "destination": "/mixtape-side-two.html" },
    { "source": "/gwor(/?)", "destination": "/gwor.html" },
    { "source": "/junkyard-cabaret", "destination": "/generated/share-pages/junkyard-cabaret.html" },
    { "source": "/grief-without-ritual(/?)", "destination": "/grief-without-ritual.html" },
    { "source": "/tootsjam/:path*", "destination": "/games/TootsJam/:path*" },
    { "source": "/tootsjam/", "destination": "/games/TootsJam/tootsjam.html" },
    { "source": "/spacetoots(/?)", "destination": "/games/SpaceToots/index.html" },
    { "source": "/spacetoots/:path*", "destination": "/games/SpaceToots/:path*" },
    { "source": "/chessblaster(/?)", "destination": "/games/ChessBlaster/dist/index.html" },
    { "source": "/chessblaster/:path*", "destination": "/games/ChessBlaster/dist/:path*" }
  ]
}
